@echo off
REM ============================================================
REM  Общие настройки. Меняй здесь, остальные скрипты берут отсюда.
REM ============================================================

REM Версия CARLA (UE4). 0.9.16 - последняя версия без Unreal Engine 5
set CARLA_VERSION=0.9.16

REM Куда установлена CARLA (папка, где лежит CarlaUE4.exe)
REM Путь БЕЗ пробелов и кириллицы!
set CARLA_ROOT=C:\CARLA\CARLA_%CARLA_VERSION%

REM Версия Python для виртуального окружения (поддерживаются 3.10, 3.11, 3.12)
set PY_VERSION=3.12

REM Папка проекта = папка, где лежит этот файл
set KIT_DIR=%~dp0
set VENV_DIR=%KIT_DIR%.venv
